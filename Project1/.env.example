# Copy this file to ".env" and fill in your key.
# Get a free key at https://aistudio.google.com/apikey

# Google AI Studio / Gemini API key (required for live answers).
GOOGLE_API_KEY=your_key_here

# Optional: override the model (default: gemini-3.8-flash).
# The free tier meters every model separately (20 requests/day each), so the
# server falls back to other models when one is rate limited or overloaded.
# GEMINI_MODEL=gemini-3.6-flash

# Optional: seconds a single agent run may take (default: 120).
# A ReAct turn needs two model calls and the free Gemini tier regularly takes
# 15-30s per call, so keep this comfortably above 60.
# AGENT_TIMEOUT=120
