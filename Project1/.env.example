# Copy this file to ".env" and fill in your key.
# Get a free key at https://aistudio.google.com/apikey

# --- pick a provider --------------------------------------------------------
# The app uses the first provider that has a key, unless PROVIDER says
# otherwise. Every provider below works with the same ReAct loop, the same
# tools, the same streaming and the same answer cache.

# Google Gemini (default when it is the only key present).
# Free tier: 20 requests per day per model - a ReAct turn costs two.
GOOGLE_API_KEY=your_key_here

# Groq - the fastest free option, and far more generous than Gemini's free
# tier. Get a key at https://console.groq.com/keys
# GROQ_API_KEY=your_key_here

# OpenRouter - one key for many models, several of them free.
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_key_here

# Cerebras - very fast inference on a free tier.
# Get a key at https://cloud.cerebras.ai
# CEREBRAS_API_KEY=your_key_here

# GitHub Models - free models with a personal access token.
# Create one at https://github.com/settings/tokens
# GITHUB_TOKEN=your_key_here

# OpenAI itself.
# OPENAI_API_KEY=your_key_here

# Force a provider (groq, openrouter, cerebras, github, openai, gemini).
# PROVIDER=groq

# --- optional tuning --------------------------------------------------------
# Override the model. The default per provider is the fastest measured one.
# AGENT_MODEL=llama-3.3-70b-versatile

# Seconds a single agent run may take (default: 120).
# AGENT_TIMEOUT=120

# Seconds one model may take before the next one is tried (default: 15).
# MODEL_ATTEMPT_SECONDS=15

# A model slower than this is parked for a while (default: 8 seconds).
# SLOW_MODEL_SECONDS=8

# How long a slow model stays parked (default: 600 seconds).
# SLOW_MODEL_COOLDOWN=600

# How long an answer stays cached (default: 3600 seconds).
# CACHE_TTL=3600
